{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intervals-coach",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "kv_namespaces": [
    {
      "binding": "COACH_CONFIG",
      "id": "e86729e84e5f45f1b71dfb9dce9bdf19",
    },
  ],
  // Writes the summary of each newly recognised session under it on Strava.
  "triggers": {
    "crons": ["*/20 * * * *"],
  },
  // Per athlete on /api/* in multi user mode; opening the plan takes about ten requests.
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Lets /healthz name the deployed version.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "observability": {
    "enabled": true,
  },
  "workers_dev": false,
}
