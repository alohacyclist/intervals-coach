{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intervals-coach",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "kv_namespaces": [
    {
      "binding": "COACH_CONFIG",
      "id": "e86729e84e5f45f1b71dfb9dce9bdf19",
    },
  ],
  // Writes the summary of each newly recognised session under it on Strava. Each
  // run only looks at athletes whose schedule is due (worker/strava-schedule.ts).
  "triggers": {
    "crons": ["*/30 * * * *"],
  },
  // Per athlete on /api/* in multi user mode; opening the plan takes about ten requests.
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Lets /healthz name the deployed version.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "observability": {
    "enabled": true,
  },
  "workers_dev": false,
  // The demo with synthetic data: `npm run deploy:demo`. A Worker of its own with
  // its own KV namespace, so it shares nothing with the real one. Bindings are not
  // inherited, hence everything is spelled out; no cron.
  // Secrets: only DEMO_PASSWORD (and optionally SESSION_SECRET) — the Worker
  // refuses to start if intervals.icu or Strava credentials are set. See docs/demo.md.
  "env": {
    "demo": {
      "name": "formkurve-demo",
      "workers_dev": true,
      "vars": { "DEMO_MODE": "on" },
      // No id on purpose: the first `npm run deploy:demo` creates the namespace
      // (Wrangler's automatic provisioning) and later deploys keep using it.
      "kv_namespaces": [{ "binding": "COACH_CONFIG" }],
      "triggers": { "crons": [] },
      // Per visitor on /api/*: the demo password travels in applications, so it is not much of a secret.
      "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
    },
  },
}
